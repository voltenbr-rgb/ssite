{
  "name": "ssite",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "ssite", "database_id": "c24f4e0c-8229-468b-bbd2-e31d4fa7307b", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [
    { "binding": "MEDIA", "id": "966c0f996f95438694039cdac819f3a6" }
  ],
  "vars": {
    "BRAND_NAME": "ssite",
    "ROOT_DOMAIN": "ssite.com.br",
    "ADMIN_USER": "admin",
    "SUPPORT_WHATSAPP": ""
  }
}
